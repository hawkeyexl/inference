{
  "name": "@hawkeyexl/inference",
  "version": "0.0.1",
  "description": "Shared TypeScript LLM inference layer: schema-constrained completion across Anthropic, OpenAI-compatible, and Claude CLI providers, with caching, cost accounting, and an LLM-as-judge ensemble.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkeyexl/inference.git"
  },
  "homepage": "https://github.com/hawkeyexl/inference#readme",
  "bugs": {
    "url": "https://github.com/hawkeyexl/inference/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "inference",
    "anthropic",
    "openai",
    "claude",
    "structured-output",
    "json-schema",
    "llm-as-judge",
    "evals"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "ajv": "^8.17.1",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
